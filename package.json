    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@highlightjs/cdn-assets": "11.12.0",
    "chart.js": "4.6.1",
    "dompurify": "3.4.17",
    "katex": "0.19.1",
    "marked": "18.2.1",
    "mermaid": "12.2.0"
  },
  "license": "MIT",
